extends SceneTree
const World = preload("res://scripts/world.gd")
var failures = 0
var checks = 0
var groups = 0

func check(condition: bool, message: String):
	checks += 1
	if not condition:
		failures += 1
		printerr("FAIL: "+message)

func group(label: String):
	groups += 1
	print("TEST "+str(groups)+": "+label)

func fresh(seed_value: int = 704219):
	var w=World.new(seed_value)
	w.data.paused=false
	return w

func finish(w, index: int = 0):
	for i in 3500:
		if w.data.pawns[index].job.is_empty(): return
		w.tick(.1)
	check(false,"Order did not finish: "+str(w.data.pawns[index].job))

func finish_all(w,index:int=0):
	for i in 7000:
		if w.data.pawns[index].job.is_empty() and w.data.pawns[index].orders.is_empty():return
		w.tick(.1)
	check(false,"Order queue did not finish: "+str(w.data.pawns[index].job)+" / "+str(w.data.pawns[index].orders))

func search(w):
	var id=w.floor_at(0).containers[0].id
	check(w.order_search(0,id)=="","Search order accepted")
	finish(w)
	return id

func take(w,id,item,amount,index=0):
	check(w.order_transfer(index,id,"take",item,amount)=="","Take accepted: "+item)
	finish(w,index)

func total_item(w,item:String)->int:
	var total=0
	for pawn in w.data.pawns:
		total+=int(pawn.inventory.get(item,0))
		if item=="armor" and pawn.get("equipment",{}).get("body","")=="armor":total+=1
	for f in w.data.floors.values():
		for c in f.containers:total+=int(c.items.get(item,0))
	return total

