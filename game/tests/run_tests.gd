	for legacy_pawn in legacy_rescue.pawns:legacy_pawn.erase("bed_id")
	var rescue_migrated=fresh(933);check(rescue_migrated.restore(JSON.stringify(legacy_rescue)),"Older saves gain unassigned treatment-bed defaults")
	check(rescue_migrated.data.pawns.all(func(legacy_pawn):return legacy_pawn.bed_id==-1),"Legacy migration invents no rescue state")
	var invalid_rescue=JSON.parse_string(rescue_world.serialize());invalid_rescue.pawns[0].bed_id=999999
	var rescue_before=rescue_migrated.serialize()
	check(not rescue_migrated.restore(JSON.stringify(invalid_rescue)) and rescue_migrated.serialize()==rescue_before,"Invalid treatment-bed references are rejected transactionally")

	group("Fatigue rewards companionship, slows hard work, and recovers without micromanagement")
	var fatigue_world=fresh();var fatigue_ash=fatigue_world.data.pawns[0];var fatigue_iona=fatigue_world.data.pawns[1]
	check(fatigue_ash.fatigue==0.0 and fatigue_world.fatigue_state(fatigue_ash)=="FRESH","Colonists begin fresh with a readable state")
	check(fatigue_world.companion_for(0)==fatigue_iona and fatigue_world.fatigue_rate(0)<0.018,"A nearby living companion visibly reduces fatigue gain")
	fatigue_iona.x=45;fatigue_iona.y=30
	check(fatigue_world.companion_for(0).is_empty() and is_equal_approx(fatigue_world.fatigue_rate(0),0.018),"Separated colonists lose the companion benefit")
	var fresh_work=fresh();var fresh_source=fresh_work.floor_at(0).containers[0];fresh_source.searched=false
	check(fresh_work.order_search(0,int(fresh_source.id))=="","Fresh work comparison accepted")
	var fresh_duration=float(fresh_work.data.pawns[0].job.duration)
	var tired_work=fresh();var tired_source=tired_work.floor_at(0).containers[0];tired_source.searched=false;tired_work.data.pawns[0].fatigue=70.0
	check(tired_work.order_search(0,int(tired_source.id))=="","Tired colonist can still work")
	check(float(tired_work.data.pawns[0].job.duration)>fresh_duration*1.27,"Fatigue measurably slows physical work")
	var fresh_move=fresh();var tired_move=fresh();var move_target=Vector2i(6,7);tired_move.data.pawns[0].fatigue=100.0
	check(fresh_move.order_walk(0,move_target)=="" and tired_move.order_walk(0,move_target)=="","Movement fatigue comparison accepts the same route")
	fresh_move.tick(.21);tired_move.tick(.21)
	check(fresh_move.point(fresh_move.data.pawns[0])==move_target and tired_move.point(tired_move.data.pawns[0])!=move_target,"Spent colonists move more slowly than fresh colonists")
	var bed_spot=Vector2i(6,7);fatigue_world.floor_at(0).structures.append(fatigue_world.make_structure("bed",bed_spot));fatigue_ash.fatigue=86.0
	fatigue_world.tick(.1)
	check(fatigue_ash.job.get("kind","")=="rest" and fatigue_ash.job.get("extra",{}).get("automatic",false),"An exhausted idle colonist claims a free bedroll automatically")
	finish(fatigue_world)
	check(fatigue_ash.fatigue<2.0 and fatigue_world.fatigue_state(fatigue_ash)=="FRESH","Bedroll rest restores an exhausted colonist")
	var unsafe_rest=fresh();var unsafe_pawn=unsafe_rest.data.pawns[0];unsafe_rest.floor_at(0).structures.append(unsafe_rest.make_structure("bed",Vector2i(6,7)));unsafe_pawn.fatigue=90.0
	unsafe_rest.spawn_enemy(0,Vector2i(8,6),"Surface husk");unsafe_rest.reveal_all();unsafe_rest.tick(.1)
	check(unsafe_pawn.job.get("kind","")!="rest","Visible threats prevent automatic sleep")
	var fatigue_save=fatigue_world.serialize();var fatigue_loaded=fresh(92)
	check(fatigue_loaded.restore(fatigue_save) and is_equal_approx(float(fatigue_loaded.data.pawns[0].fatigue),float(fatigue_ash.fatigue)),"Fatigue persists through native saves")
	var legacy_fatigue=JSON.parse_string(fatigue_save)
	for legacy_pawn in legacy_fatigue.pawns:legacy_pawn.erase("fatigue")
	var fatigue_migrated=fresh(93);check(fatigue_migrated.restore(JSON.stringify(legacy_fatigue)),"Older saves gain valid fatigue defaults")
	check(fatigue_migrated.data.pawns.all(func(legacy_pawn):return legacy_pawn.fatigue==0.0),"Legacy colonists migrate as fresh")
	var bad_fatigue=JSON.parse_string(fatigue_save);bad_fatigue.pawns[0].fatigue=101
	var fatigue_before=fatigue_loaded.serialize()
	check(not fatigue_loaded.restore(JSON.stringify(bad_fatigue)) and fatigue_loaded.serialize()==fatigue_before,"Invalid fatigue is rejected transactionally")

	group("Shared events create pair memories, bonds, and useful morale consequences")
	var social_world=fresh(940);var social_ash=social_world.data.pawns[0];var social_iona=social_world.data.pawns[1]
	check(social_ash.morale==60.0 and social_ash.bonds.is_empty() and social_ash.memories.is_empty() and social_world.morale_state(social_ash)=="STEADY","Colonists begin steady without invented relationship history")
	var social_source=social_world.floor_at(0).containers[0];social_source.searched=false
	social_ash.x=int(social_source.x);social_ash.y=int(social_source.y);social_iona.x=int(social_source.x)+1;social_iona.y=int(social_source.y)
	check(social_world.order_search(0,int(social_source.id))=="","A paired search begins as physical work");finish(social_world)
	check(social_ash.memories.size()==1 and social_iona.memories.size()==1 and social_ash.memories[0].kind=="scavenge","Nearby colonists remember a shared search on both sides")
	check(social_ash.bonds.Iona==3 and social_iona.bonds.Ash==3 and social_ash.morale==63.0 and social_iona.morale==63.0,"The shared search improves the exact pair bond and both morale values")
	check(social_world.latest_memory(social_ash).contains("Iona") and social_world.social_summary(0).contains("bond 3"),"Shared history is readable without a separate social menu")
	var memory_count=social_ash.memories.size();var morale_before_duplicate=float(social_ash.morale)
	check(not social_world.record_shared_memory(0,1,"scavenge","Repeated work with {other}.",3.0,3),"Repeating the same event type on one depth does not farm memories")
	check(social_ash.memories.size()==memory_count and social_ash.morale==morale_before_duplicate,"Duplicate memories cannot inflate morale or bonds")
	var bond_rate_before=social_world.fatigue_rate(0)
	check(social_world.record_shared_memory(0,1,"build","Raised camp with {other}.",4.0,4),"A distinct shared event adds another memory")
	check(social_ash.bonds.Iona==7 and social_world.fatigue_rate(0)<bond_rate_before,"Stronger bonds further improve the nearby-companion fatigue benefit")
	var hopeful_work=fresh(941);var shaken_work=fresh(942);hopeful_work.data.pawns[1].x=40;shaken_work.data.pawns[1].x=40
	hopeful_work.data.pawns[0].morale=80.0;shaken_work.data.pawns[0].morale=35.0
	var hopeful_source=hopeful_work.floor_at(0).containers[0];var shaken_source=shaken_work.floor_at(0).containers[0];hopeful_source.searched=false;shaken_source.searched=false
	check(hopeful_work.order_search(0,int(hopeful_source.id))=="" and shaken_work.order_search(0,int(shaken_source.id))=="","Morale work comparison accepts the same physical task")
	check(float(shaken_work.data.pawns[0].job.duration)>float(hopeful_work.data.pawns[0].job.duration)*1.27,"Shaken morale slows work while hopeful morale gives a modest boost")
	var loss_social=fresh(943);loss_social._hurt_pawn(loss_social.data.pawns[1],1000.0)
	check(loss_social.data.pawns[0].morale==35.0 and loss_social.morale_state(loss_social.data.pawns[0])=="SHAKEN","Losing a nearby colonist creates an immediate morale consequence")
	check(loss_social.data.pawns[0].memories[0].kind=="loss" and loss_social.latest_memory(loss_social.data.pawns[0]).contains("Iona"),"A colony death leaves a specific persistent loss memory")
	var bounded_social=fresh(946)
	for memory_kind in World.MEMORY_KINDS:bounded_social.record_shared_memory(0,1,memory_kind,"Shared "+memory_kind+" with {other}.",0.0,1)
	check(bounded_social.data.pawns.all(func(pawn):return pawn.memories.size()==6),"Colonists retain a bounded set of six recent relationship memories")
	check(bounded_social.data.pawns[0].bonds.Iona==8 and bounded_social.data.pawns[0].memories[0].kind=="loss","Older detail rolls off without erasing accumulated pair history")
	var social_save=social_world.serialize();var social_loaded=fresh(944)
	check(social_loaded.restore(social_save) and social_loaded.data.pawns[0].bonds.Iona==7 and social_loaded.data.pawns[0].memories.size()==2,"Morale, bonds, and bounded memories survive native saves")
	var legacy_social=JSON.parse_string(social_save)
	for legacy_pawn in legacy_social.pawns:legacy_pawn.erase("morale");legacy_pawn.erase("bonds");legacy_pawn.erase("memories")
	var social_migrated=fresh(945);check(social_migrated.restore(JSON.stringify(legacy_social)),"Older saves gain valid social-state defaults")
	check(social_migrated.data.pawns.all(func(legacy_pawn):return legacy_pawn.morale==60.0 and legacy_pawn.bonds.is_empty() and legacy_pawn.memories.is_empty()),"Legacy colonists migrate as steady with no fabricated memories")
	var bad_social=JSON.parse_string(social_save);bad_social.pawns[0].bonds.Ghost=9
	var social_before=social_loaded.serialize()
	check(not social_loaded.restore(JSON.stringify(bad_social)) and social_loaded.serialize()==social_before,"Bonds to nonexistent colonists are rejected transactionally")
	bad_social=JSON.parse_string(social_save);bad_social.pawns[0].memories[0].kind="invented"
	check(not social_loaded.restore(JSON.stringify(bad_social)) and social_loaded.serialize()==social_before,"Unknown relationship memories are rejected transactionally")

	group("Cinder Waystation can recruit a persistent third colonist for physical supplies")
	var station_world=fresh();station_world.ensure_floor(1)
	var station_marks=station_world.floor_at(1).landmarks
	check(station_marks.any(func(mark):return mark.kind=="station") and station_marks.any(func(mark):return mark.kind=="recruit"),"Transit ruins contain an inhabited waystation and survivor")
	for station_mark in station_marks:
		if station_mark.kind in ["station","recruit"]:check(station_world.walkable(1,station_world.point(station_mark)),"Waystation landmark is reachable floor space")
	var recruit_mark=station_world.recruit_landmark();var station_pawn=station_world.data.pawns[0]
	station_pawn.z=1;station_pawn.x=int(recruit_mark.x);station_pawn.y=int(recruit_mark.y)+1
	station_world.data.rumor=true;station_world.data.built_total=1;station_world.reveal_all()
	check(station_world.objective().contains("transit ruins"),"Waystation discovery is a visible expedition objective")
	check(station_world.order_recruit(0)=="","First conversation with Vale is physical")
	finish(station_world)
	check(station_world.data.station_met and not station_world.data.recruit_joined and station_world.data.pawns.size()==2,"First meeting records Vale's supply request without instant recruitment")
	check(station_world.objective().contains("2 rations") and station_world.objective().contains("medkit"),"Objective names the exact recruitment supplies")
	station_pawn.inventory.rations=1
	check(station_world.order_recruit(0)!="","Recruitment rejects missing physical supplies")
	station_pawn.inventory.rations=2;station_pawn.inventory.medkit=1
	var recruit_rations=total_item(station_world,"rations");var recruit_medkits=total_item(station_world,"medkit")
	check(station_world.order_recruit(0)=="","Exact recruitment supplies accepted")
	finish(station_world)
	check(station_world.data.recruit_joined and station_world.data.pawns.size()==3,"Vale joins as a third colonist")
	var vale=station_world.data.pawns[2]
	check(vale.name=="Vale" and vale.z==1 and vale.inventory.is_empty() and vale.skills.combat==2,"Recruit has an independent empty pack and practiced skills")
	check(vale.bonds.Ash==5 and station_pawn.bonds.Vale==5 and vale.memories[0].kind=="recruit","Recruitment creates a mutual Cinder Waystation memory with the delivering colonist")
	check(not station_world.floor_at(1).landmarks.any(func(mark):return mark.kind=="recruit"),"Recruited survivor leaves the station landmark")
	check(total_item(station_world,"rations")==recruit_rations-2 and total_item(station_world,"medkit")==recruit_medkits-1,"Recruitment consumes only the offered physical supplies")
	var vale_target=station_world.point(vale)+Vector2i(0,1)
	check(station_world.walkable(1,vale_target) and station_world.order_walk(2,vale_target)=="","Vale accepts independent movement orders")
	station_world.cancel(2)
	var recruited_save=station_world.serialize();var recruited_loaded=fresh(89)
	check(recruited_loaded.restore(recruited_save) and recruited_loaded.data.pawns.size()==3,"Recruited colonist persists without duplication")
	check(recruited_loaded.data.recruit_joined and recruited_loaded.data.pawns[2].name=="Vale","Recruitment history persists")
	var legacy_seed=fresh(90);legacy_seed.ensure_floor(1);var legacy_station=JSON.parse_string(legacy_seed.serialize())
	legacy_station.erase("station_met");legacy_station.erase("recruit_joined")
	legacy_station.floors["1"].landmarks=legacy_station.floors["1"].landmarks.filter(func(mark):return not mark.kind in ["station","recruit"])
	var station_migrated=fresh(91);check(station_migrated.restore(JSON.stringify(legacy_station)),"Older generated transit floor gains the waystation")
	check(station_migrated.floor_at(1).landmarks.any(func(mark):return mark.kind=="station") and station_migrated.floor_at(1).landmarks.any(func(mark):return mark.kind=="recruit"),"Legacy waystation migration retains an available survivor")
	var missing_recruit=JSON.parse_string(recruited_save);missing_recruit.pawns.pop_back()
	var recruited_before=recruited_loaded.serialize()
	check(not recruited_loaded.restore(JSON.stringify(missing_recruit)),"Joined state without Vale is rejected")
	check(recruited_loaded.serialize()==recruited_before,"Rejected recruit history is transactional")

	group("Save round trip retains generated history and rejects invalid input")
	w=fresh();check(w.order_talk(0)=="","Story state prepared for save");finish(w)
	w.ensure_floor(2)
	var loaded=fresh(9);check(loaded.restore(w.serialize()),"Restore native save")
	check(loaded.data.floors==w.data.floors,"All floors retained")
	check(loaded.data.rumor,"Story retained")
	var good=loaded.serialize()
	for raw in ["null","{broken","{}",'{"version":999}']:
		check(not loaded.restore(raw),"Malformed save rejected")
		check(loaded.serialize()==good,"Failed restore is transactional")
	var bad=w.data.duplicate(true);bad.pawns[0].inventory.scrap=-2
	check(not loaded.restore(JSON.stringify(bad)),"Negative inventory rejected")
	bad=w.data.duplicate(true);bad.pawns[0].orders=[{"kind":"steal","target":[6,6],"z":0,"extra":{}}]
	check(not loaded.restore(JSON.stringify(bad)),"Unknown queued action rejected")

	group("Death leaves a recoverable pack instead of deleting items")
	w=fresh();var inventory=w.data.pawns[0].inventory.duplicate(true)
	w._hurt_pawn(w.data.pawns[0],100)
	var pack=w.container_at(0,Vector2i(6,6))
	check(pack.items==inventory,"Dead colonist's items retained")
	check(w.data.pawns[0].inventory.is_empty(),"No duplicated items on body")

	print("RESULT: "+str(groups)+" groups / "+str(checks)+" checks / "+str(failures)+" failures")
	quit(1 if failures else 0)
