		check(shared.order_wayfarer(0,"repair")=="","The resupplied crew starts a saveable physical job");shared.tick(.2)
		var active_shared=fresh(1021);check(active_shared.restore(shared.serialize()) and active_shared.data.pawns[0].orders.size()==1 and active_shared.data.pawns[0].orders[0].kind=="wayfarer" and active_shared.data.pawns[1].inventory==before_donor,"Active shared repair and separate ownership survive save/load")
		active_shared.data.paused=false;finish_all(active_shared);var repaired_floor=active_shared.floor_at(52)
		check(active_shared.data.wayfarer_state==route and active_shared.data.pawns[0].inventory=={"convoy_tally":1,"roadstead_jack":0,"scrap":0} and active_shared.data.pawns[1].inventory=={"timber":1,"scrap":1},"Completion consumes exact materials from each real owner, leaves extras and preserves the tally")
		check(total_item(active_shared,"roadstead_jack")==0 and repaired_floor.containers.filter(func(c):return c.name in ["Wayfarer resident issue","Wayfarer concealed freight","Wayfarer public stores"]).size()==1,"One installed jack produces one physical supply issue")
		check(active_shared.vec(repaired_floor.down)==active_shared._wayfarer_center(repaired_floor,9) and not active_shared.path_to(52,active_shared.vec(repaired_floor.up),active_shared.vec(repaired_floor.down)).is_empty(),"The repaired settlement has a connected Underway exit")
		if route=="resident":check(active_shared.fatigue_rate(0)<-0.09,"The resident roadstead grants strong recovery")
		elif route=="hidden":check(float(active_shared.pressure_report(52).rate)<raw_pressure*.25,"The hidden roadstead grants strong pressure shelter")
		else:check(active_shared.fatigue_rate(0)<0 and float(active_shared.pressure_report(52).rate)<raw_pressure,"The public repair grants modest recovery and pressure shelter")
		active_shared.data.paused=true
		var roundtrip=fresh(1022);check(roundtrip.restore(active_shared.serialize()) and roundtrip.serialize()==active_shared.serialize(),"Completed outcome, grids, containers, owners and work round-trip byte-for-byte")
		check(active_shared.order_wayfarer(0,"repair")!="" and total_item(active_shared,"convoy_tally")==1,"The resolved repair cannot be replayed or duplicate physical proof")
		check(active_shared.order_travel(0,53)=="","The repaired road allows continued descent");active_shared.cancel(0)
		var bad_shared=JSON.parse_string(active_shared.serialize());bad_shared.wallward_state="";var safe_bytes=active_shared.serialize()
		check(not active_shared.restore(JSON.stringify(bad_shared)) and active_shared.serialize()==safe_bytes,"Invalid shared-road history is rejected atomically")
		var bad_keeper=JSON.parse_string(active_shared.serialize());bad_keeper.floors["52"].landmarks.filter(func(mark):return mark.kind=="wayfarer")[0].erase("state")
		check(not active_shared.restore(JSON.stringify(bad_keeper)) and active_shared.serialize()==safe_bytes,"Incomplete roadkeeper metadata is rejected without a runtime error or world mutation")
		var old_shared=JSON.parse_string(active_shared.serialize());old_shared.erase("wayfarer_state");old_shared.floors["52"].landmarks=old_shared.floors["52"].landmarks.filter(func(mark):return not mark.kind.begins_with("wayfarer"));var old_grid=repaired_floor.grid.duplicate(true);var old_caches=repaired_floor.containers.duplicate(true)
