extends SceneTree
# Campaign scenarios set the target directly, then exercise every sidebar choice.
# input_playtest.gd covers real map gestures and automatic arrival interactions.
var game
var failures = 0
var checks = 0
var output_dir = ProjectSettings.globalize_path("res://../qa/")

func _initialize():
	call_deferred("run")

func check(ok: bool, message: String):
	checks += 1
	if not ok:
		failures += 1
		printerr("UI FAIL: "+message)

func settle():
	for i in 5: await process_frame

func find_button(node: Node, title: String) -> Button:
	if node is Button and node.text == title: return node
	for child in node.get_children():
		var found = find_button(child,title)
		if found: return found
	return null

func click(b: Button):
	check(b != null,"Button exists")
	if not b: return
	var parent=b.get_parent()
	while parent:
		if parent is ScrollContainer:
			parent.ensure_control_visible(b)
			await settle()
		parent=parent.get_parent()
	check(b.is_visible_in_tree() and not b.disabled,"Button is usable: "+b.text)
	var event = InputEventMouseButton.new()
	event.button_index = MOUSE_BUTTON_LEFT
	event.position = b.get_global_rect().get_center()
	event.global_position = event.position
	event.pressed = true
	root.push_input(event,true)
	await process_frame
	event = event.duplicate()
	event.pressed = false
	root.push_input(event,true)
	await settle()

func capture(name: String):
	await settle()
	if DisplayServer.get_name()=="headless":
		print("LAYOUT ",name," ",root.get_visible_rect().size)
		return
	await RenderingServer.frame_post_draw
	var im = root.get_texture().get_image()
	DirAccess.make_dir_recursive_absolute(output_dir)
	check(im.save_png(output_dir+name+".png")==OK,"Screenshot saved")

func finish_order(index: int = 0):
	game.world.data.paused = false
	for i in 3500:
		if game.world.data.pawns[index].job.is_empty(): break
		game.world.tick(.1)
	check(game.world.data.pawns[index].job.is_empty(),"Physical order completes")
	await create_timer(.3).timeout
	await settle()

func finish_structure(at:Vector2i):
	game.world.data.paused=false
	for i in 7000:
		if not game.world.structure_at(0,at).is_empty():break
		game.world.tick(.1)
	check(not game.world.structure_at(0,at).is_empty(),"Colony blueprint completes")
	game.world.data.paused=true
	await settle()

func check_bounds(node: Node):
	if node is Button and node.is_visible_in_tree():
		# Item rows intentionally scroll inside their pane.
		var parent=node.get_parent()
		var scroll=false
		while parent:
			if parent is ScrollContainer: scroll=true
			parent=parent.get_parent()
		if not scroll:
			var r=node.get_global_rect()
			check(Rect2(Vector2.ZERO,root.get_visible_rect().size).encloses(r),"Button fits viewport: "+node.text)
	for child in node.get_children(): check_bounds(child)

